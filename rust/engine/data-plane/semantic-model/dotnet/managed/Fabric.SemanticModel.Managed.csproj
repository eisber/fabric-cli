<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Fabric.SemanticModel.Managed</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>LatestPatch</RollForward>
    <Deterministic>true</Deterministic>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)..\..\..\..\NuGet.Config</RestoreConfigFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)dependencies.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
    <NuGetInteractive>false</NuGetInteractive>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="BoundaryContractTests.cs" />
    <Compile Remove="Bpa\Tests\**\*.cs" />
    <PackageReference Include="Microsoft.AnalysisServices" Version="[19.118.3]" />
  </ItemGroup>
</Project>
