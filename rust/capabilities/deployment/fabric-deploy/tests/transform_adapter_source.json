      "calls": []
    },
    {
      "id": "wildcard-object-order",
      "operation": "key_value",
      "input": "{\"z\":{\"value\":1},\"a\":{\"value\":2}}",
      "parameter": {
        "find_key": "$.*.value",
        "replace_value": {
          "dev": "new"
        }
      },
