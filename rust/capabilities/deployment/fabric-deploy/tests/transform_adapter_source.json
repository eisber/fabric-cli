    {
      "id": "key-value-before-find-and-multiple-rule-order",
      "operation": "parameters",
      "input": "{\"value\":\"source\",\"second\":\"source\"}",
      "parameters": {
        "find_replace": [
          {
            "find_value": "middle",
            "replace_value": {
              "dev": "final"
            }
          },
          {
            "find_value": "final",
            "replace_value": {
              "dev": "last"
            }
          }
        ],
        "key_value_replace": [
          {
            "find_key": "$.value",
            "replace_value": {
              "dev": "middle"
            }
          },
          {
            "find_key": "$.second",
            "replace_value": {
              "dev": "middle"
            }
          }
        ]
      },
      "expected": {
        "value": "{\"value\": \"last\", \"second\": \"last\"}"
      },
      "calls": []
    }
  ]
