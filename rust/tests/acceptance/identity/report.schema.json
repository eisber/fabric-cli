{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright (c) Microsoft Corporation. Licensed under the MIT License.",
  "title": "Metadata-only experimental Windows identity acceptance checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic_test_only", "scope", "authorization", "evidence", "cases", "signoffs"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "synthetic_test_only": {"type": "boolean"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "primary_artifact_sha256", "negative_artifact_sha256", "platform", "negative_platform", "os_build", "features", "backend", "cloud", "tenant_id", "negative_tenant_id", "guest_home_tenant_id", "client_id", "account_ref", "negative_account_ref", "guest_account_ref", "principal_ref", "workspace_ids", "resource_ids", "arm_subscription_id", "fabric_host", "onelake_host", "arm_host", "audiences", "allowed_actions", "allowed_mutations", "service_mutations", "cleanup_plan_ref", "recovery_plan_ref", "cleanup_owner_ref"],
      "properties": {
        "source_sha": {"$ref": "#/$defs/sha"},
        "primary_artifact_sha256": {"$ref": "#/$defs/digest"},
        "negative_artifact_sha256": {"$ref": "#/$defs/digest"},
        "platform": {"const": "windows-x86_64"},
        "negative_platform": {"enum": ["linux-x86_64", "macos-aarch64", "macos-x86_64"]},
        "os_build": {"type": "string", "pattern": "^10\\.0\\.[0-9]{5}\\.[0-9]{1,6}$"},
        "features": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["windows-broker", "native-read"]}},
        "backend": {"const": "experimental_direct_wam"},
        "cloud": {"const": "public"},
        "tenant_id": {"$ref": "#/$defs/guid"},
        "negative_tenant_id": {"$ref": "#/$defs/guid"},
        "guest_home_tenant_id": {"$ref": "#/$defs/guid"},
        "client_id": {"$ref": "#/$defs/guid"},
        "account_ref": {"$ref": "#/$defs/ref"},
        "negative_account_ref": {"$ref": "#/$defs/ref"},
        "guest_account_ref": {"$ref": "#/$defs/ref"},
        "principal_ref": {"$ref": "#/$defs/ref"},
        "workspace_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/guid"}},
        "resource_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/guid"}},
        "arm_subscription_id": {"$ref": "#/$defs/guid"},
        "fabric_host": {"enum": ["api.fabric.microsoft.com", "msitapi.fabric.microsoft.com", "dailyapi.fabric.microsoft.com"]},
        "onelake_host": {"const": "onelake.dfs.fabric.microsoft.com"},
        "arm_host": {"const": "management.azure.com"},
        "audiences": {"const": ["https://api.fabric.microsoft.com/.default", "https://storage.azure.com/.default", "https://management.azure.com/.default"]},
        "allowed_actions": {"const": ["broker_login", "broker_silent_refresh", "broker_signout", "service_read"]},
        "allowed_mutations": {"const": ["broker_cache_update", "broker_app_signout"]},
        "service_mutations": {"const": []},
        "cleanup_plan_ref": {"$ref": "#/$defs/ref"},
        "recovery_plan_ref": {"$ref": "#/$defs/ref"},
        "cleanup_owner_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope_sha256", "approval_ref", "approver_ref", "registration_review_ref", "approved_at", "expires_at"],
      "properties": {
        "status": {"enum": ["approved", "pending", "denied"]},
        "scope_sha256": {"$ref": "#/$defs/digest"},
        "approval_ref": {"$ref": "#/$defs/ref"},
        "approver_ref": {"$ref": "#/$defs/ref"},
        "registration_review_ref": {"$ref": "#/$defs/ref"},
        "approved_at": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "source_sha", "artifact_sha256", "scope_sha256", "kind", "recorded_at", "case_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/ref"},
          "sha256": {"$ref": "#/$defs/digest"},
          "source_sha": {"$ref": "#/$defs/sha"},
          "artifact_sha256": {"$ref": "#/$defs/digest"},
          "scope_sha256": {"$ref": "#/$defs/digest"},
          "kind": {"enum": ["native_broker", "native_service", "native_clean_machine", "native_platform_negative", "offline_only"]},
          "recorded_at": {"$ref": "#/$defs/time"},
          "case_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/case_id"}}
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observation", "executed_at", "evidence_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/case_id"},
          "status": {"enum": ["executed_pass", "executed_fail", "not_run", "blocked", "unsupported"]},
          "observation": {"enum": ["expected_observed", "unexpected_observed", "not_observed"]},
          "executed_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "evidence_ids": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
        }
      }
    },
    "signoffs": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "owner_ref", "approval_ref", "status", "scope_sha256", "packet_sha256", "signed_at"],
        "properties": {
          "role": {"enum": ["release_owner", "identity_support_owner", "fabric_cli_team_reviewer", "environment_owner"]},
          "owner_ref": {"$ref": "#/$defs/ref"},
          "approval_ref": {"$ref": "#/$defs/ref"},
          "status": {"enum": ["approved", "pending", "denied"]},
          "scope_sha256": {"$ref": "#/$defs/digest"},
          "packet_sha256": {"$ref": "#/$defs/digest"},
          "signed_at": {"$ref": "#/$defs/time"}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "case_id": {"enum": ["selection_missing", "account_mismatch", "tenant_mismatch", "account_ambiguous", "guest_tenant", "audience_sequence", "partial_acquisition", "mfa", "conditional_access", "expiry_metadata", "silent_refresh", "silent_interaction_required", "cancel_lifecycle", "signout_recovery", "signout_refresh_race", "provider_absent", "no_developer_tools", "no_raw_token_fallback", "platform_absent", "fabric_read", "onelake_read", "arm_read", "secret_safe_outputs", "teardown_recovery"]}
  },
  "x-required-cases": {
    "selection_missing": "native_broker",
    "account_mismatch": "native_broker",
    "tenant_mismatch": "native_broker",
    "account_ambiguous": "native_broker",
    "guest_tenant": "native_broker",
    "audience_sequence": "native_broker",
    "partial_acquisition": "native_broker",
    "mfa": "native_broker",
    "conditional_access": "native_broker",
    "expiry_metadata": "native_broker",
    "silent_refresh": "native_broker",
    "silent_interaction_required": "native_broker",
    "cancel_lifecycle": "native_broker",
    "signout_recovery": "native_broker",
    "signout_refresh_race": "native_broker",
    "provider_absent": "native_broker",
    "no_developer_tools": "native_clean_machine",
    "no_raw_token_fallback": "native_clean_machine",
    "platform_absent": "native_platform_negative",
    "fabric_read": "native_service",
    "onelake_read": "native_service",
    "arm_read": "native_service",
    "secret_safe_outputs": "native_broker",
    "teardown_recovery": "native_broker"
  }
}
