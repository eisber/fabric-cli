            {"id": "else", "displayName": "Other", "type": "Report", "folderId": "r"}
          ]}},
          {"status": 200, "body": {"value": [
            {"id": "r", "displayName": "Root"}, {"id": "n", "displayName": "Nested", "parentFolderId": "r"},
